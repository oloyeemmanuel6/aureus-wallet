{
  "name": "aureus-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Aureus Bitcoin-only self-custody wallet for macOS",
  "author": "Aureus",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder --mac dmg",
    "package:mac": "npm run dist"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.1.1",
    "@scure/base": "^1.1.9",
    "@scure/bip32": "^1.4.0",
    "@scure/bip39": "^1.3.0",
    "bitcoinjs-lib": "^6.1.6",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "ecpair": "^2.1.0",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.441.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "tiny-secp256k1": "^2.2.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^32.0.1",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.aureus.wallet",
    "productName": "Aureus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Aureus",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
